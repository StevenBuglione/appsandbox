<Application
    x:Class="Linguum.WinUIStartupPreview.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="LinguumBackgroundColor">#FF101217</Color>
            <Color x:Key="LinguumSidebarColor">#FF181A20</Color>
            <Color x:Key="LinguumCardColor">#FF22242B</Color>
            <Color x:Key="LinguumAccentColor">#FFC9B6FF</Color>
            <SolidColorBrush x:Key="LinguumBackgroundBrush" Color="{StaticResource LinguumBackgroundColor}" />
            <SolidColorBrush x:Key="LinguumSidebarBrush" Color="{StaticResource LinguumSidebarColor}" />
            <SolidColorBrush x:Key="LinguumCardBrush" Color="{StaticResource LinguumCardColor}" />
            <SolidColorBrush x:Key="LinguumAccentBrush" Color="{StaticResource LinguumAccentColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
